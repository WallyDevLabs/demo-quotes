# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string.
#  - Local, no Docker:  npm run db:local   (listens on 54329, matches the value below)
#  - Local, Docker:     docker compose up -d  (also port 54329; use one or the other, not both)
#  - Hosted:            Neon, Supabase, Railway, etc. (use their connection string)
DATABASE_URL="postgresql://codequote:codequote@localhost:54329/codequote?schema=public"

# A SEPARATE database for the automated tests (npm run test:db creates it). The name must end in
# "_test": the auth tests create and delete real owners and refuse to run anywhere else.
TEST_DATABASE_URL="postgresql://codequote:codequote@localhost:54329/codequote_test?schema=public"

# Signs session cookies and encrypts the authenticator secret. At least 32 characters, random, and
# different for every deployment. Generate with: openssl rand -base64 32
# Changing it signs everyone out and makes stored authenticator secrets unreadable (you would re-enrol).
AUTH_SECRET=""

# Production only. The first-run page that creates the owner account asks for this value, so nobody else
# can claim a freshly deployed app before you. Set any long random string, create your account, and
# you can remove it afterwards. Without it, setup is switched off in production.
SETUP_TOKEN=""

# End-to-end test database (name must end in "_e2e"; wiped before every run). Create it with: npm run e2e:db
E2E_DATABASE_URL="postgresql://codequote:codequote@localhost:54329/codequote_e2e?schema=public"

# Portfolio demo: set to "true" to skip sign-in entirely (everyone shares one demo owner; AUTH_SECRET and SETUP_TOKEN are not needed).
DEMO_MODE=""
