{
  "name": "code-quotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:local": "node scripts/local-db.mjs",
    "test:db": "node scripts/prepare-test-db.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "e2e:db": "node scripts/prepare-e2e-db.mjs",
    "e2e": "node scripts/prepare-e2e-db.mjs && playwright test",
    "postinstall": "prisma generate",
    "build:vercel": "prisma generate && prisma migrate deploy && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "decimal.js": "10.4.3",
    "jose": "^6.2.12",
    "next": "^15.5.27",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "fast-check": "^4.10.2",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.29",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
